# Copy to .env and export values in your shell as needed.

# Required for real conversion runs
export QNN_SDK_ROOT=/opt/qairt

# Optional: if SDK archive is mounted into the container
export QAIRT_SDK_ARCHIVE=/workspace/qairt-sdk.tar.gz

# Required for AI Hub profiling mode
export QAI_HUB_API_KEY=<set-your-key-here>
export QAI_HUB_BASE_URL=https://<your-ai-hub-host>

# Optional
export IMAGE_NAME=edge-qnn-pipeline:latest
